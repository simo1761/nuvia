# ── Google Sheets (existing integration) ─────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CREDENTIALS=

# ── Backend DB (optional — enables DB storage + CAPI) ────────────
# Set to your Fastify backend URL when running on Easypanel
BACKEND_URL=http://backend:3001

# ── Tracking Pixels ───────────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# ── Backend API URL (for admin dashboard) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nuviabody.shop
